{
  "$defs": {
    "CapabilityAnalysisCoverage": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "complete"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "subjects_outside_analysis": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "Subjects one state knows about but could not analyse.\n\nCapability rows describe the *analysed* surface \u2014 what the binding graph\nproved the agent can reach. A tool that is present but unbound is precisely\nthe tool that is missing from it, so a payload that carried only the rows\nwould report no capability change on a change that added a tool (#437).\n\nThis block is the separate axis that says so, and it names the subjects\nrather than only counting them (#433). It is deliberately **not** joined to\n``subjects[]``: a tool that lost its binding is both removed from analysed\ncapability and newly outside analysis, and both statements are true.\n\n``status`` is load-bearing. Naming subjects requires having looked, so\nanything other than ``complete`` must carry an empty list \u2014 the schema\nrefuses to let \"we did not look\" be written in the same shape as \"we looked\nand found none\".",
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "unavailable",
            "complete"
          ],
          "title": "Status",
          "type": "string"
        },
        "subjects_outside_analysis": {
          "items": {
            "$ref": "#/$defs/CapabilitySubjectRef"
          },
          "title": "Subjects Outside Analysis",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "subjects_outside_analysis"
      ],
      "title": "CapabilityAnalysisCoverage",
      "type": "object"
    },
    "CapabilityAuthorityFacts": {
      "additionalProperties": false,
      "description": "Who the capability acts as, and how widely.",
      "properties": {
        "auth_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Auth Type"
        },
        "broad_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Broad Scopes",
          "type": "array"
        },
        "credential_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Credential Mode"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "auth_type",
        "credential_mode",
        "source",
        "scopes",
        "broad_scopes"
      ],
      "title": "CapabilityAuthorityFacts",
      "type": "object"
    },
    "CapabilityControlFacts": {
      "additionalProperties": false,
      "description": "Controls already declared on the action surface.",
      "properties": {
        "approval_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Required"
        },
        "approval_threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approval Threshold"
        },
        "confirmation_required": {
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "evidence_approval_ticket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Approval Ticket"
        },
        "evidence_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Owner"
        },
        "evidence_runbook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Runbook"
        },
        "safeguard_audit_log": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safeguard Audit Log"
        },
        "safeguard_dry_run": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safeguard Dry Run"
        },
        "safeguard_idempotency": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safeguard Idempotency"
        },
        "safeguard_rollback": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safeguard Rollback"
        }
      },
      "required": [
        "approval_required",
        "approval_threshold",
        "confirmation_required",
        "safeguard_idempotency",
        "safeguard_audit_log",
        "safeguard_rollback",
        "safeguard_dry_run",
        "evidence_owner",
        "evidence_runbook",
        "evidence_approval_ticket"
      ],
      "title": "CapabilityControlFacts",
      "type": "object"
    },
    "CapabilityCoverageDelta": {
      "additionalProperties": false,
      "description": "How the unanalysed surface moved between two states.\n\nOne coverage snapshot cannot answer #437's question. \"A tool was added and\nis unbound\" and \"a tool has been unbound since before this change\" are\ndifferent facts, and a reviewer only needs to act on the first \u2014 so a delta\ncarries **both** sides and names the transition between them.\n\n``newly_outside_analysis`` is the #437 row: subjects outside the analysed\nsurface in head that were not outside it in base. It is recomputed from the\ntwo sides on parse, and both directional lists must be empty unless both\nsides were actually established.",
      "properties": {
        "base": {
          "$ref": "#/$defs/CapabilityAnalysisCoverage"
        },
        "head": {
          "$ref": "#/$defs/CapabilityAnalysisCoverage"
        },
        "newly_outside_analysis": {
          "items": {
            "$ref": "#/$defs/CapabilitySubjectRef"
          },
          "title": "Newly Outside Analysis",
          "type": "array",
          "uniqueItems": true
        },
        "no_longer_outside_analysis": {
          "items": {
            "$ref": "#/$defs/CapabilitySubjectRef"
          },
          "title": "No Longer Outside Analysis",
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "not_requested",
            "unavailable",
            "complete"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "base",
        "head",
        "status",
        "newly_outside_analysis",
        "no_longer_outside_analysis"
      ],
      "title": "CapabilityCoverageDelta",
      "type": "object"
    },
    "CapabilityDeltaPayloadV1": {
      "additionalProperties": false,
      "description": "What changed between two states. The exported-attestation view (#470).",
      "properties": {
        "analysis_coverage": {
          "$ref": "#/$defs/CapabilityCoverageDelta"
        },
        "base": {
          "$ref": "#/$defs/CapabilityStateRef"
        },
        "capability_payload_schema_version": {
          "const": "shipgate.capability_payload/v1",
          "title": "Capability Payload Schema Version",
          "type": "string"
        },
        "capability_standard_version": {
          "title": "Capability Standard Version",
          "type": "string"
        },
        "head": {
          "$ref": "#/$defs/CapabilityStateRef"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/CapabilityDeltaSubject"
          },
          "title": "Subjects",
          "type": "array",
          "uniqueItems": true
        },
        "summary": {
          "$ref": "#/$defs/CapabilityDeltaSummary"
        },
        "view": {
          "const": "delta",
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "capability_payload_schema_version",
        "capability_standard_version",
        "view",
        "base",
        "head",
        "analysis_coverage",
        "summary",
        "subjects"
      ],
      "title": "CapabilityDeltaPayloadV1",
      "type": "object"
    },
    "CapabilityDeltaSubject": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "present_in_base": {
                    "const": false
                  }
                },
                "required": [
                  "present_in_base"
                ]
              },
              {
                "properties": {
                  "present_in_head": {
                    "const": true
                  }
                },
                "required": [
                  "present_in_head"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "transition": {
                "const": "added"
              }
            },
            "required": [
              "transition"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "present_in_base": {
                    "const": true
                  }
                },
                "required": [
                  "present_in_base"
                ]
              },
              {
                "properties": {
                  "present_in_head": {
                    "const": false
                  }
                },
                "required": [
                  "present_in_head"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "transition": {
                "const": "removed"
              }
            },
            "required": [
              "transition"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "present_in_base": {
                    "const": true
                  }
                },
                "required": [
                  "present_in_base"
                ]
              },
              {
                "properties": {
                  "present_in_head": {
                    "const": true
                  }
                },
                "required": [
                  "present_in_head"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "transition": {
                "const": "modified"
              }
            },
            "required": [
              "transition"
            ]
          }
        },
        {
          "not": {
            "allOf": [
              {
                "properties": {
                  "present_in_base": {
                    "const": false
                  }
                },
                "required": [
                  "present_in_base"
                ]
              },
              {
                "properties": {
                  "present_in_head": {
                    "const": false
                  }
                },
                "required": [
                  "present_in_head"
                ]
              }
            ]
          }
        }
      ],
      "description": "One subject's whole movement between two states \u2014 one subject, one row.\n\n``transition`` is recomputed from ``present_in_base`` / ``present_in_head``\nrather than supplied, so it cannot describe a movement the payload's own\npresence flags do not show.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/CapabilityRecordTransitionEntry"
          },
          "minItems": 1,
          "title": "Changes",
          "type": "array",
          "uniqueItems": true
        },
        "present_in_base": {
          "title": "Present In Base",
          "type": "boolean"
        },
        "present_in_head": {
          "title": "Present In Head",
          "type": "boolean"
        },
        "subject": {
          "$ref": "#/$defs/CapabilitySubjectRef"
        },
        "transition": {
          "enum": [
            "added",
            "removed",
            "modified"
          ],
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "present_in_base",
        "present_in_head",
        "transition",
        "changes"
      ],
      "title": "CapabilityDeltaSubject",
      "type": "object"
    },
    "CapabilityDeltaSummary": {
      "additionalProperties": false,
      "description": "Subject counts, recomputed from the rows.\n\nThe directional counts partition the subjects \u2014 every subject is added,\nremoved, or modified and nothing else \u2014 so ``subjects`` is their sum.\n``capability_changes`` is the finer number and is deliberately a *separate*\nfield: the question \"how much did this PR change what the agent can do?\" is\na question about subjects, and answering it in changes inflates the number\nby however many dimensions each subject happens to touch (#439).",
      "properties": {
        "added_subjects": {
          "minimum": 0,
          "title": "Added Subjects",
          "type": "integer"
        },
        "capability_changes": {
          "minimum": 0,
          "title": "Capability Changes",
          "type": "integer"
        },
        "modified_subjects": {
          "minimum": 0,
          "title": "Modified Subjects",
          "type": "integer"
        },
        "removed_subjects": {
          "minimum": 0,
          "title": "Removed Subjects",
          "type": "integer"
        },
        "subjects": {
          "minimum": 0,
          "title": "Subjects",
          "type": "integer"
        }
      },
      "required": [
        "subjects",
        "added_subjects",
        "removed_subjects",
        "modified_subjects",
        "capability_changes"
      ],
      "title": "CapabilityDeltaSummary",
      "type": "object"
    },
    "CapabilityDigests": {
      "additionalProperties": false,
      "description": "The per-dimension digests the fact layer already separates.\n\nPublished verbatim, under the internal field names, so a consumer comparing\ntwo payloads asks the same question the engine asks \u2014 which dimension moved\n\u2014 without re-deriving anything.",
      "properties": {
        "authority_hash": {
          "title": "Authority Hash",
          "type": "string"
        },
        "binding_hash": {
          "title": "Binding Hash",
          "type": "string"
        },
        "control_hash": {
          "title": "Control Hash",
          "type": "string"
        },
        "effect_hash": {
          "title": "Effect Hash",
          "type": "string"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        },
        "identity_hash": {
          "title": "Identity Hash",
          "type": "string"
        },
        "risk_hash": {
          "title": "Risk Hash",
          "type": "string"
        },
        "schema_hash": {
          "title": "Schema Hash",
          "type": "string"
        }
      },
      "required": [
        "identity_hash",
        "binding_hash",
        "effect_hash",
        "authority_hash",
        "control_hash",
        "schema_hash",
        "risk_hash",
        "evidence_hash"
      ],
      "title": "CapabilityDigests",
      "type": "object"
    },
    "CapabilityEffectFacts": {
      "additionalProperties": false,
      "description": "The normalized side-effect facts, as published.",
      "properties": {
        "code_execution": {
          "title": "Code Execution",
          "type": "boolean"
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "destructive",
            "external_communication",
            "financial_write",
            "production_operation",
            "privileged_data_access",
            "code_execution",
            "identity_access"
          ],
          "title": "Effect",
          "type": "string"
        },
        "externally_visible": {
          "title": "Externally Visible",
          "type": "boolean"
        },
        "financial": {
          "title": "Financial",
          "type": "boolean"
        },
        "handles_sensitive_data": {
          "title": "Handles Sensitive Data",
          "type": "boolean"
        },
        "high_risk": {
          "title": "High Risk",
          "type": "boolean"
        },
        "idempotency_known": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idempotency Known"
        },
        "reversibility": {
          "enum": [
            "reversible",
            "irreversible",
            "unknown"
          ],
          "title": "Reversibility",
          "type": "string"
        }
      },
      "required": [
        "effect",
        "externally_visible",
        "handles_sensitive_data",
        "financial",
        "code_execution",
        "reversibility",
        "idempotency_known",
        "high_risk"
      ],
      "title": "CapabilityEffectFacts",
      "type": "object"
    },
    "CapabilityEvidenceRef": {
      "additionalProperties": false,
      "description": "Where the capability was read from, and how confidently.\n\nThis is the provenance a consumer needs to open the file that made the\nclaim. ``source_location`` is deliberately absent: it is a rendering of\n``source_path`` plus ``source_start_line``, and publishing both would be two\nspellings of one value.",
      "properties": {
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "provenance_kind": {
          "enum": [
            "static_declaration",
            "ast_extraction",
            "keyword_heuristic",
            "regex_heuristic",
            "policy_pack"
          ],
          "title": "Provenance Kind",
          "type": "string"
        },
        "source_end_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source End Line"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Path"
        },
        "source_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Pointer"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
        },
        "source_start_column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Start Column"
        },
        "source_start_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Start Line"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_id",
        "source_ref",
        "source_path",
        "source_start_line",
        "source_end_line",
        "source_start_column",
        "source_pointer",
        "provenance_kind",
        "confidence"
      ],
      "title": "CapabilityEvidenceRef",
      "type": "object"
    },
    "CapabilityPermissionFacts": {
      "additionalProperties": false,
      "description": "The permission lattice classes, without the audit risk score.\n\n``classes`` and ``side_effect_unknown`` are the semantic half of\n``core.capability_lattice.CapabilityPermissionProfile`` and come from the\nsame classifier, so this payload cannot disagree with ``mcp audit``. The\nprofile's ``risk_score`` / ``risk_level`` / ``reasons`` are deliberately not\npublished \u2014 see the exclusions section of ``docs/capability-payload.md``.",
      "properties": {
        "classes": {
          "items": {
            "enum": [
              "read",
              "write",
              "destructive",
              "external",
              "financial",
              "production",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "side_effect_unknown": {
          "title": "Side Effect Unknown",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "measured",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "classes",
        "side_effect_unknown"
      ],
      "title": "CapabilityPermissionFacts",
      "type": "object"
    },
    "CapabilityRecord": {
      "additionalProperties": false,
      "description": "One capability of one subject: an operation with its effect and authority.\n\n``capability_id`` is the internal ``CapabilityFactV1.id`` verbatim. It is the\njoin key back to the fact layer and the reason the round trip in\n``tests/test_capability_payload.py`` can compare published rows with the\nfacts that produced them.",
      "properties": {
        "authority": {
          "$ref": "#/$defs/CapabilityAuthorityFacts"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "controls": {
          "$ref": "#/$defs/CapabilityControlFacts"
        },
        "digests": {
          "$ref": "#/$defs/CapabilityDigests"
        },
        "effect": {
          "$ref": "#/$defs/CapabilityEffectFacts"
        },
        "evidence": {
          "$ref": "#/$defs/CapabilityEvidenceRef"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/CapabilityPermissionFacts"
        },
        "resource": {
          "items": {
            "type": "string"
          },
          "title": "Resource",
          "type": "array"
        },
        "risk_tags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Tags",
          "type": "array"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "subject_kind": {
          "enum": [
            "tool",
            "action",
            "scope",
            "policy",
            "ci",
            "baseline",
            "agent_instruction",
            "manifest",
            "unknown"
          ],
          "title": "Subject Kind",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "operation",
        "subject_kind",
        "resource",
        "scope",
        "effect",
        "authority",
        "controls",
        "permission",
        "evidence",
        "risk_tags",
        "digests"
      ],
      "title": "CapabilityRecord",
      "type": "object"
    },
    "CapabilityRecordTransitionEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "transition": {
                "const": "added"
              }
            },
            "required": [
              "transition"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "before": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "after": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "changed_dimensions": {
                    "maxItems": 0
                  }
                }
              },
              {
                "properties": {
                  "semantic_direction": {
                    "const": "added"
                  }
                },
                "required": [
                  "semantic_direction"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transition": {
                "const": "removed"
              }
            },
            "required": [
              "transition"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "before": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "after": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "changed_dimensions": {
                    "maxItems": 0
                  }
                }
              },
              {
                "properties": {
                  "semantic_direction": {
                    "const": "removed"
                  }
                },
                "required": [
                  "semantic_direction"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transition": {
                "const": "changed"
              }
            },
            "required": [
              "transition"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "before": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "after": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "changed_dimensions": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "semantic_direction": {
                    "not": {
                      "enum": [
                        "added",
                        "removed"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transition": {
                "const": "reidentified"
              }
            },
            "required": [
              "transition"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "before": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "after": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "properties": {
                  "changed_dimensions": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "semantic_direction": {
                    "not": {
                      "enum": [
                        "added",
                        "removed"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "description": "How one capability record moved between the two states.\n\n``before`` / ``after`` are populated by the transition: ``added`` has no\nbefore, ``removed`` has no after, and ``changed`` / ``reidentified`` carry\nboth. Everything a consumer would otherwise have to take on trust \u2014\n``changed_dimensions``, the identity relationship between the two sides, and\nwhether the direction is honest \u2014 is derived from the records themselves, so\na contradictory attestation is rejected rather than carried.",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed_dimensions": {
          "items": {
            "enum": [
              "identity_hash",
              "binding_hash",
              "effect_hash",
              "authority_hash",
              "control_hash",
              "schema_hash",
              "risk_hash",
              "evidence_hash"
            ],
            "type": "string"
          },
          "title": "Changed Dimensions",
          "type": "array"
        },
        "semantic_changes": {
          "items": {
            "$ref": "#/$defs/CapabilitySemanticChange"
          },
          "title": "Semantic Changes",
          "type": "array"
        },
        "semantic_direction": {
          "enum": [
            "added",
            "removed",
            "broadened",
            "narrowed",
            "mixed",
            "unknown",
            "evidence_only"
          ],
          "title": "Semantic Direction",
          "type": "string"
        },
        "transition": {
          "enum": [
            "added",
            "removed",
            "changed",
            "reidentified"
          ],
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "transition",
        "changed_dimensions",
        "semantic_direction",
        "semantic_changes",
        "before",
        "after"
      ],
      "title": "CapabilityRecordTransitionEntry",
      "type": "object"
    },
    "CapabilitySemanticChange": {
      "additionalProperties": false,
      "description": "One semantic explanation for a capability delta.",
      "properties": {
        "after": {
          "default": null,
          "title": "After"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field",
        "rationale"
      ],
      "title": "CapabilitySemanticChange",
      "type": "object"
    },
    "CapabilityStatePayloadV1": {
      "additionalProperties": false,
      "description": "What the agent can do, at one state. The committed-state view (#474).",
      "properties": {
        "analysis_coverage": {
          "$ref": "#/$defs/CapabilityAnalysisCoverage"
        },
        "capability_payload_schema_version": {
          "const": "shipgate.capability_payload/v1",
          "title": "Capability Payload Schema Version",
          "type": "string"
        },
        "capability_standard_version": {
          "title": "Capability Standard Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapabilityStateRef"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/CapabilityStateSubject"
          },
          "title": "Subjects",
          "type": "array",
          "uniqueItems": true
        },
        "view": {
          "const": "state",
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "capability_payload_schema_version",
        "capability_standard_version",
        "view",
        "state",
        "analysis_coverage",
        "subjects"
      ],
      "title": "CapabilityStatePayloadV1",
      "type": "object"
    },
    "CapabilityStateRef": {
      "additionalProperties": false,
      "description": "What a payload says about one whole state, including one it does not carry.\n\nA delta names its two sides here. The digests are computed over the\n*published* content of the full state, so a consumer holding both the state\npayload and the delta payload can prove they describe the same state without\nre-running anything of ours.\n\n``ref`` is an opaque caller label \u2014 a commit sha, a lock path \u2014 and is never\na timestamp: this payload carries no wall clock, so two exports of the same\ninputs are byte-identical.",
      "properties": {
        "analysis_coverage_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Analysis Coverage Digest",
          "type": "string"
        },
        "capability_count": {
          "minimum": 0,
          "title": "Capability Count",
          "type": "integer"
        },
        "capability_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capability Set Digest",
          "type": "string"
        },
        "capability_standard_version": {
          "title": "Capability Standard Version",
          "type": "string"
        },
        "evidence_set_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Set Digest",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ref"
        },
        "subject_count": {
          "minimum": 0,
          "title": "Subject Count",
          "type": "integer"
        }
      },
      "required": [
        "capability_standard_version",
        "subject_count",
        "capability_count",
        "capability_set_digest",
        "evidence_set_digest",
        "analysis_coverage_digest",
        "ref"
      ],
      "title": "CapabilityStateRef",
      "type": "object"
    },
    "CapabilityStateSubject": {
      "additionalProperties": false,
      "description": "One subject and every capability it holds in one state.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityRecord"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "subject": {
          "$ref": "#/$defs/CapabilitySubjectRef"
        }
      },
      "required": [
        "subject",
        "capabilities"
      ],
      "title": "CapabilityStateSubject",
      "type": "object"
    },
    "CapabilitySubjectRef": {
      "additionalProperties": false,
      "description": "The thing a reader recognizes: one tool, under one agent and provider.\n\n``key`` is the row identity for the whole payload. It is derived from\n``agent``/``provider``/``tool_id`` only \u2014 deliberately **not** from\n``subject_kind`` \u2014 because a tool and its action are the same subject to a\nreader, and keying on the kind is precisely how one added tool became two\nrows and a ``+2`` (#439).\n\n``name`` is the adopter-facing spelling and is not identity: two providers\nmay ship the same name. Consumers that render a name must qualify it with\n``provider`` when two rows share one ``name``.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "key": {
          "pattern": "^capsubj_[0-9a-f]{16}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name",
        "agent",
        "provider",
        "tool_id"
      ],
      "title": "CapabilitySubjectRef",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/ThreeMoonsLab/agents-shipgate/main/docs/capability-payload-schema.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Frozen JSON Schema for shipgate.capability_payload/v1 \u2014 the one capability payload shared by the exported capability delta and the committed capability state. Generated from agents_shipgate.schemas.capability_payload.CapabilityPayloadV1. Two views discriminated on `view`; one subject is one row. VALIDATION IS TWO STAGES: this file is stage one and is not sufficient on its own. The rules that require recomputation \u2014 subject-key derivation, summary and transition rollups, changed-dimension derivation, state-digest verification, cross-row uniqueness, and the coverage transition \u2014 cannot be expressed in JSON Schema and are listed as stage two in docs/capability-payload.md; a consumer that runs only stage one does not have the guarantees the spec states. It is non-gating and is not part of report.json; release_decision.decision remains the only gate.",
  "discriminator": {
    "mapping": {
      "delta": "#/$defs/CapabilityDeltaPayloadV1",
      "state": "#/$defs/CapabilityStatePayloadV1"
    },
    "propertyName": "view"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CapabilityStatePayloadV1"
    },
    {
      "$ref": "#/$defs/CapabilityDeltaPayloadV1"
    }
  ],
  "title": "Agents Shipgate Capability Payload v1"
}
