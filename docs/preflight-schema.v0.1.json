        "scope_type": {
          "enum": [
            "whole_file",
            "key_level",
            "capability_surface"
          ],
          "title": "Scope Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "pattern",
        "scope_type"
      ],
      "title": "TrustRootNodeV1",
      "type": "object"
    }
