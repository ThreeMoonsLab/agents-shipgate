{
  "$defs": {
    "CapabilityChange": {
      "additionalProperties": false,
      "description": "One deterministic \"what changed about agent capability?\" row.\n\nProjected from ``action_surface_diff`` / ``tool_surface_diff`` rows and\njoined to ``findings`` + ``release_decision`` for ``release_impact``.\n``release_impact`` mirrors the gate (``release_decision``); this block\nnever introduces a finding-independent blocker.",
      "properties": {
        "change_type": {
          "enum": [
            "action_added",
            "action_removed",
            "action_modified",
            "tool_added",
            "tool_removed",
            "tool_modified",
            "scope_added",
            "scope_removed",
            "scope_modified",
            "approval_policy_removed",
            "ci_gate_modified",
            "shipgate_policy_modified",
            "agent_instruction_modified",
            "baseline_modified",
            "waiver_or_suppression_modified"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provenance_kind": {
          "default": "static_declaration",
          "title": "Provenance Kind",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "related_finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Finding Ids",
          "type": "array"
        },
        "release_impact": {
          "default": "none",
          "enum": [
            "none",
            "informational",
            "review_required",
            "blocks_release",
            "insufficient_evidence"
          ],
          "title": "Release Impact",
          "type": "string"
        },
        "risk_tags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Tags",
          "type": "array"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_start_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start Line"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "tool",
            "action",
            "scope",
            "policy",
            "ci",
            "baseline",
            "agent_instruction",
            "manifest",
            "unknown"
          ],
          "title": "Subject Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "change_type",
        "subject_kind",
        "subject",
        "rationale"
      ],
      "title": "CapabilityChange",
      "type": "object"
    },
    "VerifierHumanReview": {
      "additionalProperties": false,
      "description": "Whether a human must review before merge, and why.",
      "properties": {
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        }
      },
      "title": "VerifierHumanReview",
      "type": "object"
    },
    "VerifierNextAction": {
      "additionalProperties": false,
      "description": "The single recommended next step after verify, with the actor who\nshould take it. ``actor`` distinguishes work a coding agent may do\nmechanically from decisions that require a human.",
      "properties": {
        "actor": {
          "default": "human",
          "enum": [
            "coding_agent",
            "human"
          ],
          "title": "Actor",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "kind": {
          "default": "review",
          "title": "Kind",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        }
      },
      "title": "VerifierNextAction",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/ThreeMoonsLab/agents-shipgate/main/docs/verifier-schema.v0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON Schema for verifier.json. Generated from agents_shipgate.schemas.verifier.VerifierArtifact. Do not edit by hand.",
  "properties": {
    "agent_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Summary"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "base_notes": {
      "items": {
        "type": "string"
      },
      "title": "Base Notes",
      "type": "array"
    },
    "base_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Ref"
    },
    "base_report_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Report Json"
    },
    "base_status": {
      "default": "not_requested",
      "enum": [
        "not_requested",
        "skipped",
        "diff_from_provided",
        "ref_missing",
        "archive_failed",
        "missing_manifest",
        "scan_failed",
        "cache_hit",
        "succeeded"
      ],
      "title": "Base Status",
      "type": "string"
    },
    "base_tree_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Tree Sha"
    },
    "can_merge_without_human": {
      "default": false,
      "title": "Can Merge Without Human",
      "type": "boolean"
    },
    "capability_changes": {
      "items": {
        "$ref": "#/$defs/CapabilityChange"
      },
      "title": "Capability Changes",
      "type": "array"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "config": {
      "title": "Config",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision"
    },
    "diff_text_available": {
      "default": false,
      "title": "Diff Text Available",
      "type": "boolean"
    },
    "first_next_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifierNextAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "head_exit_code": {
      "default": 0,
      "title": "Head Exit Code",
      "type": "integer"
    },
    "head_ref": {
      "default": "HEAD",
      "title": "Head Ref",
      "type": "string"
    },
    "head_report_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Head Report Json"
    },
    "head_status": {
      "default": "skipped",
      "enum": [
        "skipped",
        "succeeded",
        "failed"
      ],
      "title": "Head Status",
      "type": "string"
    },
    "headline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Headline"
    },
    "human_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerifierHumanReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "merge_verdict": {
      "default": "unknown",
      "enum": [
        "mergeable",
        "human_review_required",
        "insufficient_evidence",
        "blocked",
        "unknown"
      ],
      "title": "Merge Verdict",
      "type": "string"
    },
    "mode": {
      "default": "advisory",
      "title": "Mode",
      "type": "string"
    },
    "release_decision": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Decision"
    },
    "reviewer_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Summary"
    },
    "trigger": {
      "additionalProperties": true,
      "title": "Trigger",
      "type": "object"
    },
    "trust_root_touched": {
      "default": false,
      "title": "Trust Root Touched",
      "type": "boolean"
    },
    "verifier_schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Verifier Schema Version",
      "type": "string"
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    }
  },
  "required": [
    "workspace",
    "config"
  ],
  "title": "Agents Shipgate Verifier Artifact v0.1",
  "type": "object"
}
