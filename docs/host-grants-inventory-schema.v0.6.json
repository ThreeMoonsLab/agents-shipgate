          "title": "Sha256"
        },
        "status": {
          "enum": [
            "guidance",
            "structured",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "status",
        "reason"
      ],
      "title": "InstructionStructureEvidence",
      "type": "object"
    }
