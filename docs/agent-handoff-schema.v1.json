    "AgentHandoffTool": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "agents-shipgate",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "0.15.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "AgentHandoffTool",
      "type": "object"
    }
