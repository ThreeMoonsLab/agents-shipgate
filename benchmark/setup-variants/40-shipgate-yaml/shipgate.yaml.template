# yaml-language-server: $schema=https://raw.githubusercontent.com/ThreeMoonsLab/agents-shipgate/main/docs/manifest-v0.1.json
#
# Benchmark variant: existing shipgate.yaml.
# The harness overlay renderer (harness/adoption/overlay.py) fills the
# placeholders below from harness/adoption/context.py::ARCHETYPE_CONTEXTS so
# the rendered manifest is doctor-clean for every archetype. Manual testers
# can also fill these in by hand — see benchmark/runner.md.

version: "0.1"

project:
  name: "{{REPO_NAME}}"

agent:
  name: "{{AGENT_NAME}}"
  declared_purpose:
    - "{{ONE_LINE_PURPOSE}}"
  prohibited_actions: []

environment:
  target: local

tool_sources:
{{TOOL_SOURCES}}

policies:
  require_approval_for_tools: []
  require_confirmation_for_tools: []
  require_idempotency_for_tools: []

permissions:
  scopes: []

ci:
  mode: advisory

output:
  directory: agents-shipgate-reports
  formats:
    - markdown
    - json
