{
  "tools": [
    {
      "name": "orders.return_quote",
      "description": "Quote what returning these items would credit back to the customer, without submitting anything.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "type": "string"
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "order_id",
          "amount_cents"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      },
      "auth": {
        "type": "api_key",
        "scopes": [
          "orders:read"
        ]
      }
    },
    {
      "name": "accounts.add_note",
      "description": "Append a note to the account so the account team sees the context.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "note"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "auth": {
        "type": "api_key",
        "scopes": [
          "accounts:notes:write"
        ]
      }
    }
  ]
}
