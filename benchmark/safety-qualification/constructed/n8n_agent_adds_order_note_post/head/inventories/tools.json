{
  "tools": [
    {
      "name": "lookup_order",
      "description": "Fetch an order's status, items and shipping details by order id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Order identifier"
          }
        },
        "required": [
          "order_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true
      },
      "auth": {
        "mode": "none"
      }
    },
    {
      "name": "add_order_note",
      "description": "Append a note to the order's timeline so the warehouse sees it.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order_id": {
            "type": "string",
            "description": "Order identifier"
          },
          "note": {
            "type": "string",
            "description": "Note text for the warehouse team"
          }
        },
        "required": [
          "order_id",
          "note"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "auth": {
        "type": "api_key",
        "scopes": [
          "orders:notes:write"
        ]
      }
    }
  ]
}
