{
  "agent_boundary_result_schema_path": "docs/agent-boundary-result-schema.v2.json",
  "agent_boundary_result_schema_version": "shipgate.agent_boundary_result/v2",
  "agent_control_fields": [
    "state",
    "reason",
    "completion_allowed",
    "must_stop",
    "verify_required",
    "next_action",
    "allowed_next_commands",
    "permissions",
    "human_review",
    "stop_reason"
  ],
  "agent_control_permissions": [
    "edit",
    "commit",
    "push",
    "update_pr",
    "merge",
    "report_complete"
  ],
  "agent_control_states": [
    "complete",
    "agent_action_required",
    "review_publishable",
    "human_review_required"
  ],
  "agent_handoff_artifact": "agents-shipgate-reports/agent-handoff.json",
  "agent_handoff_schema_path": "docs/agent-handoff-schema.v7.json",
  "agent_handoff_schema_version": "shipgate.agent_handoff/v7",
  "agent_interface_operations": [
    "verify_pr",
    "verify_local",
    "verify_preview"
  ],
  "agent_read_order": [
    "current-control.json",
    "current-control.json.current_control_id",
    "current-control.json.lifecycle_state",
    "current-control.json.control.state",
    "verification-receipt.json",
    "verification-receipt.json.request_id",
    "verification-receipt.json.receipt_id",
    "agent-handoff.json",
    "agent-handoff.json.control.state",
    "agent-handoff.json.authorization",
    "verifier.json.control.state",
    "verify-run.json",
    "report.json.release_decision.decision"
  ],
  "agent_refresh_triggers": [
    "after any human action or external tool action",
    "after commit, rebase, checkout, pull, or any other worktree mutation",
    "after any agents-shipgate command returns",
    "before enforcing a cached must_stop",
    "before commit, push, or PR update when permission depends on Shipgate",
    "before merge or release",
    "before declaring the task complete",
    "whenever the observed request_id, HEAD, worktree identity, or current_control_id changes"
  ],
  "agent_result_control_fields": [
    "decision",
    "control",
    "repair",
    "policy"
  ],
  "agent_result_schema_path": "docs/agent-result-schema.v3.json",
  "agent_result_schema_version": "agent_result_v3",
  "agents_shipgate_version": "0.16.0b7",
  "artifacts": {
    "agent_handoff": "agents-shipgate-reports/agent-handoff.json",
    "attestation": "agents-shipgate-reports/attestation.json",
    "current_control": "agents-shipgate-reports/current-control.json",
    "host_grants": "agents-shipgate-reports/host-grants.json",
    "human_authorization": "agents-shipgate-reports/human-authorization.json",
    "human_authorization_request": "agents-shipgate-reports/human-authorization-request.json",
    "org_evidence_bundle": "agents-shipgate-reports/org-evidence-bundle.json",
    "org_status": "agents-shipgate-reports/org-status.json",
    "packet": "agents-shipgate-reports/packet.json",
    "pr_comment": "agents-shipgate-reports/pr-comment.md",
    "registry": ".agents-shipgate/registry.jsonl",
    "report": "agents-shipgate-reports/report.json",
    "verification_artifact_manifest": "agents-shipgate-reports/verification-artifacts.json",
    "verification_plan": "agents-shipgate-reports/verification-plan.json",
    "verification_receipt": "agents-shipgate-reports/verification-receipt.json",
    "verification_unit_result": "agents-shipgate-reports/verification-unit-result.json",
    "verifier": "agents-shipgate-reports/verifier.json",
    "verify_run": "agents-shipgate-reports/verify-run.json"
  },
  "attestation_schema_version": "0.5",
  "codex_boundary_result_schema_version": "shipgate.codex_boundary_result/v2",
  "commands": {
    "agent_check_claude_code": "shipgate check --agent claude-code --workspace . --format agent-boundary-json",
    "agent_check_codex": "shipgate check --agent codex --workspace . --format agent-boundary-json",
    "agent_check_cursor": "shipgate check --agent cursor --workspace . --format agent-boundary-json",
    "agent_control": "agents-shipgate agent control --workspace . --reports-dir agents-shipgate-reports",
    "agent_handoff": "agents-shipgate agent handoff --from agents-shipgate-reports/verifier.json --json",
    "attest": "agents-shipgate attest --from agents-shipgate-reports/verifier.json --out agents-shipgate-reports/attestation.json",
    "authorization_execute": "agents-shipgate authorization execute --workspace . --receipt agents-shipgate-reports/verification-receipt.json --artifacts-root agents-shipgate-reports",
    "authorization_request": "agents-shipgate authorization request --receipt agents-shipgate-reports/verification-receipt.json --artifacts-root agents-shipgate-reports --remote origin --destination-ref refs/heads/<branch> --expected-lease-oid <oid> --out agents-shipgate-reports/human-authorization-request.json",
    "contract": "agents-shipgate contract --json",
    "host_audit": "shipgate audit --host --json --out agents-shipgate-reports/host-grants.json",
    "install_agent_workflow": "agents-shipgate init --workspace . --write --json",
    "org_bundle": "agents-shipgate org bundle --config shipgate.yaml --from agents-shipgate-reports/verifier.json --out agents-shipgate-reports/org-evidence-bundle.json --json",
    "org_policy_packs": "agents-shipgate org policy-packs --config shipgate.yaml --json",
    "preflight": "agents-shipgate preflight --workspace . --config shipgate.yaml --plan - --json",
    "preview": "agents-shipgate verify --preview --json",
    "registry_summary": "agents-shipgate registry summary --registry .agents-shipgate/registry.jsonl --json",
    "registry_verify": "agents-shipgate registry verify --registry .agents-shipgate/registry.jsonl --json",
    "verification_assemble": "agents-shipgate verification assemble --plan agents-shipgate-reports/verification-plan.json --unit-result agents-shipgate-reports/verification-unit-result.json --verifier agents-shipgate-reports/verifier.json --artifacts-root agents-shipgate-reports --out agents-shipgate-reports/verification-receipt.json",
    "verification_prepare": "agents-shipgate verification prepare --workspace . --config shipgate.yaml --base origin/main --head HEAD --out agents-shipgate-reports/verification-plan.json",
    "verification_reproduce": "agents-shipgate verification reproduce --receipt agents-shipgate-reports/verification-receipt.json --artifacts-root agents-shipgate-reports",
    "verification_worker": "agents-shipgate verification worker --plan agents-shipgate-reports/verification-plan.json --workspace . --out agents-shipgate-reports/verification-unit-result.json",
    "verify_local": "agents-shipgate verify --workspace . --config shipgate.yaml --ci-mode advisory --json",
    "verify_pr": "agents-shipgate verify --workspace . --config shipgate.yaml --base origin/main --head HEAD --ci-mode advisory --json"
  },
  "contract_version": "21",
  "current_control_artifact": "agents-shipgate-reports/current-control.json",
  "current_control_fallback_read_order": [
    "current-control.json",
    "verification-receipt.json",
    "agent-handoff.json",
    "verifier.json",
    "report.json"
  ],
  "current_control_schema_path": "docs/current-control-schema.v1.json",
  "current_control_schema_version": "shipgate.current_control/v1",
  "default_paths": {
    "local_contract": ".shipgate/agent-contract.json",
    "manifest": "shipgate.yaml",
    "reports_dir": "agents-shipgate-reports"
  },
  "do_not_auto_assert": [
    "action_effect",
    "action_authority",
    "agent_binding",
    "approval",
    "confirmation",
    "idempotency",
    "broad-scope",
    "prohibited-action",
    "runtime-trace",
    "human-ack",
    "human-authorization",
    "suppression",
    "waiver",
    "baseline",
    "policy-weakening"
  ],
  "exit_code_policy": {
    "0": "command completed; inspect JSON verdict fields for release state",
    "2": "configuration or CLI flag error",
    "20": "strict-mode gate failure or opt-in governance failure",
    "3": "input parse or missing artifact error",
    "4": "other or internal error",
    "6": "baseline integrity failure"
  },
  "gating_signal": "release_decision.decision",
  "host_grants_baseline_schema_version": "0.2",
  "host_grants_drift_schema_version": "0.2",
  "host_grants_inventory_schema_version": "0.2",
  "human_authorization_evaluation_schema_version": "shipgate.human_authorization_evaluation/v1",
  "human_authorization_request_schema_version": "shipgate.human_authorization_request/v1",
  "human_authorization_schema_path": "docs/human-authorization-schema.v1.json",
  "human_authorization_schema_version": "shipgate.human_authorization/v1",
  "human_authorization_trust_policy_default_path": "~/.config/agents-shipgate/human-authorization-trust-policy.json",
  "human_authorization_trust_policy_schema_version": "shipgate.human_authorization_trust_policy/v1",
  "mcp_tools": [
    "shipgate.check",
    "shipgate.preflight",
    "shipgate.explain",
    "shipgate.capabilities",
    "shipgate.handoff"
  ],
  "merge_verdicts": [
    "mergeable",
    "human_review_required",
    "insufficient_evidence",
    "blocked",
    "unknown"
  ],
  "minimum_control_contract_version": "21",
  "org_evidence_bundle_schema_version": "shipgate.org_evidence_bundle/v2",
  "primary_commands": {
    "check_claude_code": "shipgate check --agent claude-code --workspace . --format agent-boundary-json",
    "check_codex": "shipgate check --agent codex --workspace . --format agent-boundary-json",
    "check_cursor": "shipgate check --agent cursor --workspace . --format agent-boundary-json",
    "host_audit": "shipgate audit --host --json --out agents-shipgate-reports/host-grants.json",
    "verify_pr": "agents-shipgate verify --workspace . --config shipgate.yaml --base origin/main --head HEAD --ci-mode advisory --json"
  },
  "registry_schema_version": "0.4",
  "release_decisions": [
    "passed",
    "review_required",
    "insufficient_evidence",
    "blocked"
  ],
  "schema_version": "9",
  "trigger_catalog_schema_version": "0.3",
  "verification_artifact_manifest_schema_version": "shipgate.verification_artifact_manifest/v1",
  "verification_plan_schema_version": "shipgate.verification_plan/v1",
  "verification_receipt_schema_version": "shipgate.verification_receipt/v1",
  "verification_unit_result_schema_version": "shipgate.verification_unit_result/v1",
  "verifier_read_order": [
    "control.state",
    "authorization",
    "execution",
    "merge_verdict",
    "applicability",
    "can_merge_without_human",
    "control.next_action",
    "fix_task",
    "capability_review.top_changes",
    "release_decision.decision",
    "request_id",
    "decision_id"
  ],
  "verifier_schema_version": "0.8",
  "verify_run_schema_version": "shipgate.verify_run/v4"
}
