{
  "tools": [
    {
      "name": "lookup_case",
      "description": "Look up support case metadata for a known case id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string"}
        },
        "required": ["case_id"]
      },
      "annotations": {"readOnlyHint": true},
      "auth": {"mode": "none"}
    },
    {
      "name": "request_refund_approval",
      "description": "Create an internal refund approval request without issuing funds.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string"},
          "amount": {"type": "number", "minimum": 0}
        },
        "required": ["case_id", "amount"]
      },
      "permission_class": "write",
      "auth": {"mode": "none"}
    }
  ]
}
